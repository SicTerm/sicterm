<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- SIC ships one x64 build. The console host package (Microsoft.Windows.Console.ConPTY) reads this before a project's own
         PlatformTarget is set, so it is given here: it copies x64\OpenConsole.exe and arm64\OpenConsole.exe (an x64 SIC on an
         ARM64 PC runs the native ARM64 host) into every project that references the package directly. -->
    <ConptyNativePlatform Condition="'$(ConptyNativePlatform)' == ''">x64</ConptyNativePlatform>
  </PropertyGroup>
</Project>
