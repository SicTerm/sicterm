// One Half Dark for SIC. terminal: the scheme built into Windows Terminal (defaults.json); chrome: Atom One Dark's editor, tree view and border surfaces, its text tones and UI accent
{
  "id": "one-half-dark",
  "name": "One Half Dark",
  "family": "One Half",
  "light": false,
  "chrome": {
    "base": "#282C34",
    "rail": "#181A1F",
    "panel": "#21252B",
    "text": "#DCDFE4",
    "textSecondary": "#9DA5B4",
    "textTertiary": "#5C6370",
    "neutral": "#5C6370",
    "accent": "#528BFF",
    "success": "#98C379",
    "warning": "#E5C07B",
    "danger": "#E06C75"
