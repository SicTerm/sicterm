    "background": "#282C34",
    "foreground": "#DCDFE4",
    "cursorColor": "#FFFFFF",
    "black": "#282C34",
    "red": "#E06C75",
    "green": "#98C379",
    "yellow": "#E5C07B",
    "blue": "#61AFEF",
    "purple": "#C678DD",
    "cyan": "#56B6C2",
    "white": "#DCDFE4",
    "brightBlack": "#5A6374",
    "brightRed": "#E06C75",
    "brightGreen": "#98C379",
    "brightYellow": "#E5C07B",
    "brightBlue": "#61AFEF",
    "brightPurple": "#C678DD",
    "brightCyan": "#56B6C2",
    "brightWhite": "#DCDFE4"
  }
}
