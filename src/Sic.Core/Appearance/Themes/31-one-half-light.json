// One Half Light for SIC. terminal: the scheme built into Windows Terminal (defaults.json); chrome: Atom One Light's editor and tree view surfaces, its text tones and UI accent
{
  "id": "one-half-light",
  "name": "One Half Light",
  "family": "One Half",
  "light": true,
  "chrome": {
    "base": "#FAFAFA",
    "rail": "#0000001A",
    "panel": "#EAEAEB",
    "text": "#383A42",
    "textSecondary": "#696C77",
    "textTertiary": "#A0A1A7",
    "neutral": "#A0A1A7",
    "accent": "#526FFF",
    "accentText": "#FFFFFF",
    "success": "#50A14F",
    "warning": "#C18301",
    "danger": "#E45649"
  },
  "terminal": {
    "name": "One Half Light",
    "background": "#FAFAFA",
    "foreground": "#383A42",
    "cursorColor": "#4F525D",
    "selectionBackground": "#383A42",
    "black": "#383A42",
    "red": "#E45649",
    "green": "#50A14F",
    "yellow": "#C18301",
    "blue": "#0184BC",
    "purple": "#A626A4",
    "cyan": "#0997B3",
    "white": "#FAFAFA",
    "brightBlack": "#4F525D",
    "brightRed": "#DF6C75",
    "brightGreen": "#98C379",
    "brightYellow": "#E4C07A",
    "brightBlue": "#61AFEF",
    "brightPurple": "#C577DD",
    "brightCyan": "#56B5C1",
    "brightWhite": "#FFFFFF"
  }
}
